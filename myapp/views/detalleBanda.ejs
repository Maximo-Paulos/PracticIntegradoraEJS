<!DOCTYPE html>
<html>
  <head>
    <title><%= banda ? banda.nombre : 'Banda' %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <p><a href="/bandas">Volver al listado</a></p>

    <% if (!banda) { %>
      <h1>Banda no encontrada</h1>
      <p>No existe la banda con id <%= id %>.</p>
    <% } else { %>
      <h1><%= banda.nombre %></h1>

      <p>
        Género:
        <a href="/bandas/genero/<%= encodeURIComponent(banda.genero) %>"><%= banda.genero %></a>
      </p>

      <p><strong>Cantidad de integrantes:</strong> <%= banda.integrantes %></p>

      <% if (banda.cover) { %>
        <p>
          <img src="/<%= banda.cover %>" width="260" alt="<%= banda.nombre %>" />
        </p>
      <% } %>

      <h2>Mejores canciones</h2>
      <ul>
        <% banda.topCanciones.forEach(function(c) { %>
          <li><%= c %></li>
        <% }) %>
      </ul>

      <% if (banda.video) { %>
        <h2>Video</h2>
        <p>
          <a href="<%= banda.video %>" target="_blank" rel="noopener noreferrer">
            Ver en YouTube
          </a>
        </p>
      <% } %>
    <% } %>
  </body>
</html>

