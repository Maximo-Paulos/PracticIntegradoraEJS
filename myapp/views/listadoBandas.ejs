<!DOCTYPE html>
<html>
  <head>
    <title>Listado de Bandas</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <h1>Listado de Bandas</h1>

    <ul>
      <% bandas.forEach(function(banda) { %>
        <li>
          <a href="/bandas/<%= banda.id %>"><%= banda.nombre %></a>
          <br />
          <img src="/<%= banda.cover %>" width="180" alt="<%= banda.nombre %>" />
        </li>
      <% }) %>
    </ul>
  </body>
</html>

