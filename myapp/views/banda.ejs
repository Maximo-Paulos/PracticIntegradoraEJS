<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <p><a href="/bandas">Volver al listado</a></p>

    <h1><%= banda.nombre %></h1>
    <p><strong>Género:</strong> <%= banda.genero %></p>
    <p><strong>Integrantes:</strong> <%= banda.integrantes %></p>

    <% if (banda.cover) { %>
      <p>
        <img src="/<%= banda.cover %>" alt="<%= banda.nombre %>" width="200" />
      </p>
    <% } %>

    <h2>Top canciones</h2>
    <ul>
      <% banda.topCanciones.forEach(function(cancion) { %>
        <li><%= cancion %></li>
      <% }) %>
    </ul>

    <% if (banda.video) { %>
      <h2>Video</h2>
      <p>
        <a href="<%= banda.video %>" target="_blank" rel="noopener noreferrer">
          Ver en YouTube
        </a>
      </p>
    <% } %>
  </body>
</html>
